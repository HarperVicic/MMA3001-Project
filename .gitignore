# Python virtual environment
.venv/

# Raw data: the uncompressed CSVs exceed GitHub's 100 MB limit, so only the
# zipped copies (*.csv.zip) and the small sensor registry are committed.
DATA/*.csv

# Python, Jupyter and test caches
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/

# Word lock files and OS/editor files
~$*
.DS_Store
Thumbs.db
